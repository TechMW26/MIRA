# Firebase / storage
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mira-3ffa4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mira-3ffa4
# Server-side signed sessions for existing MIRA accounts (minimum 32 characters).
MIRA_AUTH_SECRET=
BLOB_READ_WRITE_TOKEN=
MIRA_MEDIA_SIGNING_SECRET=
MIRA_ALLOWED_ORIGINS=https://www.itsmira.cloud,https://itsmira.cloud
CRON_SECRET=

# Optional web search providers
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# Optional preferred AI-native search/crawl provider. Without it, the secure built-in crawler and search fallbacks remain active.
JINA_API_KEY=

# Optional Chrome/WebTools MCP Streamable HTTP gateway
MIRA_BROWSER_MCP_URL=
MIRA_BROWSER_MCP_TOKEN=
MIRA_BROWSER_MCP_TOOL=browser.inspectWebsite

# Pollinations image/video generation, image analysis, and desktop coding fallback (server-side key)
POLLINATIONS_API_URL=https://gen.pollinations.ai
POLLINATIONS_API_KEY=
POLLINATIONS_VIDEO_MODEL=wan-pro
# Vision model used for image analysis via Pollinations' OpenAI-compatible API.
POLLINATIONS_VISION_MODEL=openai

# DeepSeek powers desktop coding/workspace completions and is the fallback for
# web chat, voice, and search-query planning when the MIRA provider is unavailable.
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_AGENT_MODEL=deepseek-v4-pro
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
MIRA_DESKTOP_CODING_PROVIDER=deepseek

# Authenticated multilingual voice service. These values are server-side only.
MIRA_VOICE_API_URL=https://voice.example.com
MIRA_VOICE_API_KEY=
POCKET_TTS_VOICE=azelma
HINDI_NEURAL_VOICE=hi-IN-SwaraNeural
HINDI_NEURAL_RATE=+5%

# Primary web chat provider (OpenAI-compatible). Falls back to DeepSeek.
MIRA_BASE_URL=
MIRA_OPENAI_BASE_URL=
MIRA_API_TOKEN=
MIRA_CHAT_MODEL=MIRA:latest
