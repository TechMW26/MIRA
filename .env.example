# Firebase / storage
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mira-3ffa4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mira-3ffa4
# Temporary local-only compatibility during migration; never enable in production.
VITE_ENABLE_LEGACY_AUTH=false
BLOB_READ_WRITE_TOKEN=
MIRA_MEDIA_SIGNING_SECRET=
MIRA_ALLOWED_ORIGINS=https://www.itsmira.cloud,https://itsmira.cloud
CRON_SECRET=

# Chat server. The backend discovers the available completion model from /api/tags.
OLLAMA_API_URL=http://50.35.188.73:20005/api/chat
# Optional internal override for testing a completion-capable model from /api/tags.
# This is never exposed as a frontend model selector.
OLLAMA_CHAT_MODEL=
# Optional internal voice override. When empty, voice selects a non-vision
# completion model dynamically from the same /api/tags registry.
OLLAMA_VOICE_MODEL=
OLLAMA_MAX_TOKENS=12000
# Maximum context. MIRA allocates 2K/4K/8K/16K adaptively per request.
OLLAMA_CONTEXT_TOKENS=16384
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.85
OLLAMA_REPEAT_PENALTY=1.05
OLLAMA_KEEP_ALIVE=-1
OLLAMA_VISION_KEEP_ALIVE=0
# Time allowed for a cold model to load before Ollama returns response headers.
OLLAMA_CONNECT_TIMEOUT_MS=28000
OLLAMA_START_TIMEOUT_MS=50000

# Gemini is an image-analysis fallback only. Ollama selects the primary vision
# model dynamically from /api/tags. Supply fallback keys as CSV or JSON.
GEMINI_API_KEYS=
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional web search providers
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# Optional preferred AI-native search/crawl provider. Without it, the secure built-in crawler and search fallbacks remain active.
JINA_API_KEY=

# Optional Chrome/WebTools MCP Streamable HTTP gateway
MIRA_BROWSER_MCP_URL=
MIRA_BROWSER_MCP_TOKEN=
MIRA_BROWSER_MCP_TOOL=browser.inspectWebsite

# Pollinations image/video generation (server-side key)
POLLINATIONS_API_URL=https://gen.pollinations.ai
POLLINATIONS_API_KEY=
POLLINATIONS_VIDEO_MODEL=wan-pro

# DeepSeek handles fast general completions and desktop coding. Packaged apps
# store their credential in the OS encrypted credential store.
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_AGENT_MODEL=deepseek-v4-pro
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
MIRA_CHAT_PROVIDER=deepseek

# Authenticated multilingual voice service. These values are server-side only.
MIRA_VOICE_API_URL=https://voice.example.com
MIRA_VOICE_API_KEY=
POCKET_TTS_VOICE=azelma
HINDI_NEURAL_VOICE=hi-IN-SwaraNeural
HINDI_NEURAL_RATE=+5%
