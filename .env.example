# Copy this file to `.env` (gitignored) and fill in real values.
# Never commit `.env` or any file containing live credentials.
# In production, set these in Vercel Project Settings -> Environment Variables.

# ── Chat model (Ollama-compatible) ────────────────────────────
# Chat endpoint; the model is discovered from /api/tags.
OLLAMA_API_URL=http://localhost:11434/api/chat
# Optional override; must match a completion model from /api/tags.
OLLAMA_CHAT_MODEL=
OLLAMA_MAX_TOKENS=12000
OLLAMA_CONTEXT_TOKENS=16384
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.85
OLLAMA_REPEAT_PENALTY=1.05
# -1 keeps the model loaded indefinitely.
OLLAMA_KEEP_ALIVE=-1
# 0 unloads the vision model immediately after analysis.
OLLAMA_VISION_KEEP_ALIVE=0
OLLAMA_START_TIMEOUT_MS=50000

# ── Vision fallback (Gemini) ──────────────────────────────────
# Primary vision runs on Ollama; Gemini is the ordered-key fallback.
GEMINI_API_KEYS=
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Web search providers (all optional) ───────────────────────
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ── Image / video generation (Pollinations, server-side key) ──
POLLINATIONS_API_KEY=
POLLINATIONS_VIDEO_MODEL=wan-pro

# ── Chrome MCP gateway (optional server-side inspection) ──────
MIRA_BROWSER_MCP_URL=
MIRA_BROWSER_MCP_TOKEN=
MIRA_BROWSER_MCP_TOOL=

# ── Firebase (client-visible config) ──────────────────────────
VITE_FIREBASE_DATABASE_URL=

# ── Local dev only ────────────────────────────────────────────
# Port for dev-api.js (defaults to 3002).
API_PORT=3002
