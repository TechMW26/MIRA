# Firebase / storage
VITE_FIREBASE_DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Chat server. The backend discovers the available completion model from /api/tags.
OLLAMA_API_URL=http://147.93.102.103:11434/api/chat
OLLAMA_MAX_TOKENS=12000
OLLAMA_CONTEXT_TOKENS=0
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.85
OLLAMA_REPEAT_PENALTY=1.2

# Gemini is isolated to image analysis. Supply one key, a comma-separated
# fallback chain, or a JSON array. This model is never used for normal chat.
GEMINI_API_KEYS=
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional web search providers
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Optional Chrome/WebTools MCP Streamable HTTP gateway
MIRA_BROWSER_MCP_URL=
MIRA_BROWSER_MCP_TOKEN=
MIRA_BROWSER_MCP_TOOL=browser.inspectWebsite

# Image/video generation
POLLINATIONS_API_KEY=
POLLINATIONS_VIDEO_MODEL=wan-pro
