# Firebase / storage
VITE_FIREBASE_DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Chat providers
SALAD_API_URL=https://persimmon-chives-tx4dggpups3smlon.salad.cloud/api/chat
SALAD_API_KEY=
SALAD_API_KEY_HEADER=Salad-Api-Key
# Standard Mira uses the model exposed by the VPS Ollama registry.
OLLAMA_API_URL=http://147.93.102.103:11434/api/chat
MIRA_MODEL=mira:latest
# Mira Pro and Locked both use Salad's `mira-pro` deployment.
MIRA_PRO_MODEL=mira-pro
OLLAMA_MAX_TOKENS=12000
OLLAMA_CONTEXT_TOKENS=0
MIRA_V4_TEMPERATURE=0.2
MIRA_V4_TOP_P=0.85
MIRA_V4_REPEAT_PENALTY=1.2
# (LITE_* caps below also gate Mira Lite output length — raise them if replies look truncated.)

# Mira Lite (single selected Gemini model; no fallback)
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
MIRA_LITE_MODEL=gemini-3.5-flash
GEMINI_QUERY_MODEL=gemini-2.5-flash
GEMINI_API_KEYS=
LITE_MAX_MESSAGES=16
LITE_MAX_CHARS_PER_MESSAGE=4000
LITE_MAX_SYSTEM_CHARS=6000
LITE_MAX_OUTPUT_TOKENS=4096

# Optional Chrome/WebTools MCP Streamable HTTP gateway
MIRA_BROWSER_MCP_URL=
MIRA_BROWSER_MCP_TOKEN=
MIRA_BROWSER_MCP_TOOL=browser.inspectWebsite

# Image/video generation (unchanged)
POLLINATIONS_API_KEY=
POLLINATIONS_VIDEO_MODEL=wan-pro
