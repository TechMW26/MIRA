{
  "name": "mira",
  "private": true,
  "version": "1.1.7",
  "description": "MIRA - Multi-Intelligent Responsive Assistant",
  "author": "MW FutureTech",
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --restart-tries -1 --restart-after exponential --names api,web \"node --watch dev-api.js\" \"vite\"",
    "dev:api": "node --watch dev-api.js",
    "dev:vite": "vite",
    "test": "node --test src/services/*.test.js api/*.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently --kill-others-on-fail --names web,desktop \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:3000 && electron desktop/main.cjs --dev\"",
    "desktop:build": "npm run build && electron-builder",
    "desktop:pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@vercel/blob": "^2.3.3",
    "docx": "^9.6.1",
    "dompurify": "^3.4.5",
    "firebase": "^11.6.0",
    "highlight.js": "^11.11.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^3.8.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.2",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^5.6.205",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.5",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.1.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "cloud.itsmira.desktop",
    "productName": "MIRA",
    "icon": "public/mira-logo.png",
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "en",
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MIRA uses the microphone only for voice conversations and audio features you start.",
        "NSCameraUsageDescription": "MIRA uses the camera only for camera and visual-assistance features you start.",
        "NSScreenCaptureUsageDescription": "MIRA uses screen recording only when you ask it to inspect or assist with your screen.",
        "NSAppleEventsUsageDescription": "MIRA uses approved automation to operate apps only when you request it.",
        "NSDesktopFolderUsageDescription": "MIRA accesses Desktop folders only when you select them as a workspace.",
        "NSDocumentsFolderUsageDescription": "MIRA accesses Documents folders only when you select them as a workspace.",
        "NSDownloadsFolderUsageDescription": "MIRA accesses Downloads folders only when you select them as a workspace."
      },
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
