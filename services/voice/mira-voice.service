[Unit]
Description=MIRA multilingual voice service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=mira-voice
Group=mira-voice
WorkingDirectory=/opt/mira-voice/source
EnvironmentFile=/etc/mira-voice.env
Environment=HF_HOME=/var/lib/mira-voice/huggingface
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mira-voice/.venv/bin/uvicorn mira_voice:app --host 127.0.0.1 --port 8765 --workers 1 --proxy-headers
Restart=always
RestartSec=2
TimeoutStartSec=600
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mira-voice /tmp
MemoryMax=24G
TasksMax=512

[Install]
WantedBy=multi-user.target
